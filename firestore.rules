rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function authed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberDoc(c) { return get(/databases/$(db)/documents/clubMembers/$(c + '_' + me())); }
    function isActive(c) { return authed() && exists(/databases/$(db)/documents/clubMembers/$(c + '_' + me())) && memberDoc(c).data.status == 'active'; }
    function isAdmin(c) { return isActive(c) && memberDoc(c).data.role == 'admin'; }
    function isStaff(c) { return isActive(c) && memberDoc(c).data.role in ['admin','staff']; }
    function can(c, k, def) {
      let p = get(/databases/$(db)/documents/clubs/$(c)).data.get('permissions', {}).get(k, {});
      let r = memberDoc(c).data.role;
      return isActive(c) && (r == 'admin'
        || (r == 'staff' && p.get('staff', p.get('mode', def) == 'staff'))
        || (p.get('custom', p.get('mode', '') == 'custom') && me() in p.get('users', []))
        || p.get('all', false) == true);
    }
    function closedPrimary(c) {
      let d = get(/databases/$(db)/documents/clubs/$(c)).data;
      return authed() && d.get('status', 'open') == 'closed' && d.primaryAdminId == me() && request.time > d.closedAt + duration.value(90, 'd');
    }
    // 개발자(받은 의견 보기): 아래 이메일을 내 구글 이메일로 바꿔 주세요
    function isDev() { return authed() && request.auth.token.email == 'leeeh12101@gmail.com' && request.auth.token.email_verified == true; }
    function isAdminAfter(c) { return authed() && getAfter(/databases/$(db)/documents/clubMembers/$(c + '_' + me())).data.role == 'admin'; }

    match /users/{u} { allow read, write: if authed() && me() == u; }

    match /clubs/{c} {
      allow get: if authed();
      allow list: if authed() && resource.data.visibility == 'public';
      allow create: if authed() && request.resource.data.createdBy == me();
      allow update: if (isAdmin(c) && resource.data.get('status', 'open') == 'open'
          && (resource.data.primaryAdminId == me()
              || (request.resource.data.get('status', 'open') == 'open' && request.resource.data.primaryAdminId == resource.data.primaryAdminId)))
        || (isAdmin(c) && resource.data.primaryAdminId == me() && resource.data.get('status', 'open') == 'closed' && request.resource.data.get('status', 'open') == 'open')
        || (resource.data.get('status', 'open') == 'open' && can(c, 'schedule', 'admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regularDays','regularStartTime','regularEndTime','regularCourtCount','roundInterval','noPlayEnabled','mode','qrule','monthly','schedType','schedM','cnum','rclose']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'tiers', 'admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tierEnabled','tiers']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'stats', 'admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statsOff','rankShow']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'meeting', 'staff') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mtgOverride','mdays','sched']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'notice', 'staff') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notice']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'result', 'staff') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gOk']))
        || (resource.data.get('status', 'open') == 'open' && can(c, 'draw', 'staff') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dprio']) && request.resource.data.dprio is list && request.resource.data.dprio.size() <= 8);
      allow delete: if closedPrimary(c);
    }

    // 초대코드는 관리자만 볼 수 있고, 코드를 아는 사람은 get 으로만 확인 가능
    match /clubPrivate/{c} {
      allow read: if isAdmin(c);
      allow create: if isAdminAfter(c);
      allow update: if isAdmin(c);
      allow delete: if closedPrimary(c);
    }
    match /inviteCodes/{code} {
      allow get: if authed();
      allow create: if isAdminAfter(request.resource.data.clubId);
      allow delete: if isAdmin(resource.data.clubId);
    }

    match /clubMembers/{m} {
      allow delete: if closedPrimary(resource.data.clubId);
      allow read: if authed() && (resource.data.uid == me() || isActive(resource.data.clubId));
      allow create: if authed() && m == request.resource.data.clubId + '_' + request.resource.data.uid && (
        (request.resource.data.uid == me() && (
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(db)/documents/clubs/$(request.resource.data.clubId)).data.createdBy == me())
          ||
          (request.resource.data.role == 'member' && request.resource.data.status == 'active'
            && (get(/databases/$(db)/documents/clubs/$(request.resource.data.clubId)).data.joinMethod == 'open'
              || ('viaCode' in request.resource.data
                  && get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.viaCode)).data.clubId == request.resource.data.clubId)))))
        ||
        (can(request.resource.data.clubId, 'members', 'admin') && request.resource.data.role == 'member' && request.resource.data.status == 'active')
      );
      allow create: if authed() && request.resource.data.get('offline', false) == true && request.resource.data.uid == '' && request.resource.data.role == 'member'
        && m.matches(request.resource.data.clubId + '_o.*') && can(request.resource.data.clubId, 'members', 'admin');
      allow delete: if resource.data.get('offline', false) == true && isAdmin(resource.data.clubId);
      allow update: if authed() && (
        isAdmin(resource.data.clubId)
        || (can(resource.data.clubId, 'tiers', 'admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tierId']))
        || (can(resource.data.clubId, 'members', 'admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gender']))
        || (can(resource.data.clubId, 'members', 'admin') && resource.data.status == 'withdrawn' && request.resource.data.role == 'member' && request.resource.data.status == 'active')
        || (resource.data.uid == me() && request.resource.data.uid == me() && request.resource.data.clubId == resource.data.clubId && (
             (resource.data.status == 'active' && request.resource.data.role == resource.data.role && request.resource.data.get('tierId', null) == resource.data.get('tierId', null))
             || (resource.data.status == 'withdrawn' && request.resource.data.status == 'active' && request.resource.data.role == 'member'
                 && (get(/databases/$(db)/documents/clubs/$(resource.data.clubId)).data.joinMethod == 'open'
                     || ('viaCode' in request.resource.data && get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.viaCode)).data.clubId == resource.data.clubId))))));
    }

    match /clubApplications/{a} {
      allow create: if authed() && request.resource.data.uid == me() && a == request.resource.data.clubId + '_' + me();
      allow delete: if closedPrimary(resource.data.clubId);
      allow read: if authed() && (resource.data.uid == me() || can(resource.data.clubId, 'members', 'admin'));
      allow update: if can(resource.data.clubId, 'members', 'admin')
        || (authed() && resource.data.uid == me() && resource.data.status != 'pending' && request.resource.data.uid == me() && request.resource.data.status == 'pending');
    }

    match /sessionParticipants/{p} {
      allow read: if isActive(resource.data.clubId);
      allow create, update: if authed() && (
        (request.resource.data.uid == me() && isActive(request.resource.data.clubId)
          && p == request.resource.data.clubId + '_' + request.resource.data.date + '_' + me())
        || can(request.resource.data.clubId, 'guest', 'staff') || can(request.resource.data.clubId, 'meeting', 'staff'));
      allow delete: if can(resource.data.clubId, 'guest', 'staff') || can(resource.data.clubId, 'meeting', 'staff') || closedPrimary(resource.data.clubId);
    }

    match /sessions/{s} {
      allow delete: if closedPrimary(resource.data.clubId) || can(resource.data.clubId, 'meeting', 'staff');
      allow get: if isActive(s.split('_')[0]);
      allow list: if isActive(resource.data.clubId);
      allow create: if can(request.resource.data.clubId, 'draw', 'staff') || can(request.resource.data.clubId, 'meeting', 'staff');
      allow update: if can(request.resource.data.clubId, 'draw', 'staff') || can(request.resource.data.clubId, 'meeting', 'staff')
        || (resource.data.get('drawWriterId', '') == me() && request.resource.data.get('drawWriterId', '') == me());
    }

    match /games/{g} {
      allow read: if isActive(resource.data.clubId);
      allow create: if can(request.resource.data.clubId, 'result', 'staff')
        || (isActive(request.resource.data.clubId) && request.resource.data.get('source', '') == 'queue' && me() in request.resource.data.pk);
      allow update: if can(request.resource.data.clubId, 'result', 'staff');
      allow delete: if can(resource.data.clubId, 'result', 'staff') || closedPrimary(resource.data.clubId);
    }

    match /aiUsage/{u} {
      allow get: if authed() && (u.matches(me() + '_.*') || isActive(u.split('_')[0]));
      allow create, update: if authed() && request.resource.data.date is string && u == request.resource.data.ownerId + '_' + request.resource.data.date && (
        (request.resource.data.kind == 'user' && request.resource.data.ownerId == me() && request.resource.data.count <= 2)
        || (request.resource.data.kind == 'club' && can(request.resource.data.ownerId, 'result', 'staff') && request.resource.data.count <= 5));
    }

    match /aiDrawUsage/{u} {
      allow get: if authed() && isActive(u.split('_')[0]);
      allow create, update: if authed() && u == request.resource.data.clubId + '_' + request.resource.data.date
        && can(request.resource.data.clubId, 'draw', 'staff') && request.resource.data.count <= 1;
    }

    match /queues/{qd} {
      allow read: if isActive(qd.split('_')[0]);
      allow create, update: if isActive(request.resource.data.clubId) && qd == request.resource.data.clubId + '_' + request.resource.data.date;
    }

    match /feedback/{f} {
      allow create: if authed() && request.resource.data.uid == me() && request.resource.data.text is string && request.resource.data.text.size() <= 2000 && request.resource.data.status == 'new';
      allow read: if authed() && (resource.data.uid == me() || isDev());
      allow update: if isDev();
      allow delete: if authed() && resource.data.uid == me();
    }

    // 게스트 기록 보내기(운영진이 만든 링크, 링크를 가진 로그인 사용자만 열람)
    match /guestShares/{s} {
      allow get: if authed();
      // 개인 모드 공유(kind 'p')는 누구나 자기 이름으로, 클럽 게스트 공유는 결과 권한자만
      allow create: if authed() && request.resource.data.createdBy == me() && (request.resource.data.get('kind', '') == 'p' || can(request.resource.data.clubId, 'result', 'staff'));
      allow delete: if authed() && resource.data.createdBy == me();
    }

    // 포백 테스트 측정 카운터: 누구나 1씩만 올릴 수 있고, 개발자만 읽음
    match /ftStats/{d} {
      allow read: if isDev();
      allow create: if d in ['done', 'doneE', 'inv', 'invDone'] && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // 포백 테스트 궁합: 짧은 코드로 초대(A)를 보관, 파트너가 결과(B)를 한 번만 채움. 30일 만료
    match /ftShares/{c} {
      allow get: if true;
      allow list: if authed() && resource.data.owner == me();
      allow create: if request.resource.data.keys().hasOnly(['A', 'owner', 'at', 'exp'])
        && (request.resource.data.owner == '' || (authed() && request.resource.data.owner == me()))
        && request.resource.data.exp is number && request.resource.data.exp < request.time.toMillis() + 2764800000;
      allow update: if !('B' in resource.data) && resource.data.exp > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['B', 'bAt'])
        && request.resource.data.B.keys().hasOnly(['n', 'h', 'a']);
      allow delete: if authed() && resource.data.owner == me();
      // 응답(파트너 결과): 여러 명이 각자 추가만 가능, 수정·삭제 불가
      match /r/{r} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['B', 'at']) && request.resource.data.B.keys().hasOnly(['n', 'h', 'a'])
          && get(/databases/$(db)/documents/ftShares/$(c)).data.exp > request.time.toMillis();
      }
    }

    match /personalGames/{g} {
      allow create: if authed() && request.resource.data.ownerUid == me();
      allow read, update, delete: if authed() && resource.data.ownerUid == me();
    }
    match /personalPeople/{p} {
      allow create: if authed() && request.resource.data.ownerUid == me();
      allow read, update, delete: if authed() && resource.data.ownerUid == me();
    }
    // 나에 대한 메모(본인만)
    match /personalNotes/{n} {
      allow create: if authed() && request.resource.data.ownerUid == me() && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if authed() && resource.data.ownerUid == me() && request.resource.data.ownerUid == me() && request.resource.data.text.size() <= 1000;
      allow read, delete: if authed() && resource.data.ownerUid == me();
    }
    // 주차권(모임당 30장, 당일 자정/끝난 뒤 3시간 삭제, 가져가기)·모임 사진(3장, 7일): 날짜·종류별 목록 + 사진 1장당 문서 1개
    function clubOn(c, f) { return get(/databases/$(db)/documents/clubs/$(c)).data.get(f, false) == true; }
    // 1015-5: 목록 항목은 한 번에 하나만 바뀜(올리기=추가 1개, 가져가기·돌려놓기·메모·다시 읽기=1개 수정, 지우기=삭제만)
    function pdNew(k, i) { return i.by == me() && !('t' in i) && !('q' in i) && !exists(/databases/$(db)/documents/clubPhotos/$(k)); }
    function pdChg(c, a, b) {
      return a.by == b.by && a.at == b.at && a.exp == b.exp
        && (a.get('qh', '') == b.get('qh', '') || a.by == me())
        && a.get('q', '') == b.get('q', '')
        && (a.get('t', '') == b.get('t', '')
              ? (a.get('t', '') == me() || a.by == me() || isAdmin(c))
              : ((a.get('t', '') == '' && b.get('t', '') == me())
                 || (a.get('t', '') != '' && b.get('t', '') == '' && (a.get('t', '') == me() || isAdmin(c)))));
    }
    // 바뀌는 항목 id는 앱이 ch에 적어 보냄(규칙의 Set에는 원소를 꺼내는 기능이 없음 — 1015-7)
    function pdItemsOk(c) {
      let o = resource == null ? {} : resource.data.items;
      let n = request.resource.data.items;
      // n.diff(o): addedKeys = 새로 생긴 칸, removedKeys = 지운 칸 (방향 주의 — 1016-4)
      let d = n.diff(o);
      let k = request.resource.data.get('ch', '');
      return (d.addedKeys().size() == 0 && d.changedKeys().size() == 0)
        || (k != '' && d.addedKeys().size() == 1 && d.addedKeys().hasOnly([k]) && d.changedKeys().size() == 0 && d.removedKeys().size() == 0 && pdNew(k, n[k]))
        || (k != '' && d.changedKeys().size() == 1 && d.changedKeys().hasOnly([k]) && d.addedKeys().size() == 0 && d.removedKeys().size() == 0 && pdChg(c, o[k], n[k]));
    }
    match /photoDays/{d} {
      allow get: if isActive(d.split('_')[0]);
      allow list: if isActive(resource.data.clubId);
      allow create, update: if isActive(request.resource.data.clubId)
        && request.resource.data.kind in ['park', 'group']
        && d == request.resource.data.clubId + '_' + request.resource.data.date + '_' + request.resource.data.kind
        && request.resource.data.keys().hasOnly(['clubId', 'date', 'kind', 'n', 'items', 'updatedAt', 'ch'])
        && request.resource.data.n == request.resource.data.items.size()
        && request.resource.data.n <= (request.resource.data.kind == 'park' ? 30 : 3)
        && pdItemsOk(request.resource.data.clubId);
      allow delete: if isActive(resource.data.clubId);
    }
    match /clubPhotos/{p} {
      // 주차권 사진·QR은 가져간 사람만(올린 사람은 QR 다시 읽기용으로 자기 것만)
      allow read: if isActive(resource.data.clubId)
        && (resource.data.kind != 'park' || resource.data.by == me()
          || get(/databases/$(db)/documents/photoDays/$(resource.data.clubId + '_' + resource.data.date + '_park')).data.items[p].get('t', '') == me());
      allow update: if authed() && resource.data.by == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qr'])
        && request.resource.data.qr is string && request.resource.data.qr.size() <= 2000;
      allow create: if authed() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['clubId', 'date', 'kind', 'by', 'byName', 'exp', 'data', 'w', 'h', 'at', 'qr'])
        && request.resource.data.get('qr', '').size() <= 2000
        && request.resource.data.data is string && request.resource.data.data.size() <= 750000
        && request.resource.data.exp is number && request.resource.data.exp <= request.time.toMillis() + 777600000
        && getAfter(/databases/$(db)/documents/photoDays/$(request.resource.data.clubId + '_' + request.resource.data.date + '_' + request.resource.data.kind)).data.items[p].by == me()
        && ((request.resource.data.kind == 'park' && clubOn(request.resource.data.clubId, 'parkOn') && can(request.resource.data.clubId, 'park', 'staff'))
          || (request.resource.data.kind == 'group' && clubOn(request.resource.data.clubId, 'photoOn') && can(request.resource.data.clubId, 'photo', 'staff')));
      allow delete: if authed() && (resource == null || (isActive(resource.data.clubId)
        && (resource.data.by == me() || isAdmin(resource.data.clubId) || resource.data.exp < request.time.toMillis())));
    }
  }
}
