rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function authed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberDoc(c) { return get(/databases/$(db)/documents/clubMembers/$(c + '_' + me())); }
    function isActive(c) { return authed() && exists(/databases/$(db)/documents/clubMembers/$(c + '_' + me())) && memberDoc(c).data.status == 'active'; }
    function isAdmin(c) { return isActive(c) && memberDoc(c).data.role == 'admin'; }
    function isAdminAfter(c) { return authed() && getAfter(/databases/$(db)/documents/clubMembers/$(c + '_' + me())).data.role == 'admin'; }

    match /users/{u} { allow read, write: if authed() && me() == u; }

    match /clubs/{c} {
      allow get: if authed();
      allow list: if authed() && resource.data.visibility == 'public';
      allow create: if authed() && request.resource.data.createdBy == me();
      allow update: if isAdmin(c);
    }

    // 초대코드는 관리자만 볼 수 있고, 코드를 아는 사람은 get 으로만 확인 가능
    match /clubPrivate/{c} {
      allow read: if isAdmin(c);
      allow create: if isAdminAfter(c);
      allow update: if isAdmin(c);
    }
    match /inviteCodes/{code} {
      allow get: if authed();
      allow create: if isAdminAfter(request.resource.data.clubId);
      allow delete: if isAdmin(resource.data.clubId);
    }

    match /clubMembers/{m} {
      allow read: if authed() && (resource.data.uid == me() || isActive(resource.data.clubId));
      allow create: if authed() && request.resource.data.uid == me()
        && m == request.resource.data.clubId + '_' + me()
        && (
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(db)/documents/clubs/$(request.resource.data.clubId)).data.createdBy == me())
          ||
          (request.resource.data.role == 'member' && request.resource.data.status == 'active'
            && (get(/databases/$(db)/documents/clubs/$(request.resource.data.clubId)).data.joinMethod == 'open'
              || ('viaCode' in request.resource.data
                  && get(/databases/$(db)/documents/inviteCodes/$(request.resource.data.viaCode)).data.clubId == request.resource.data.clubId)))
        );
      allow update: if authed() && (isAdmin(resource.data.clubId)
        || (resource.data.uid == me() && request.resource.data.role == resource.data.role
            && request.resource.data.clubId == resource.data.clubId));
    }

    match /clubApplications/{a} {
      allow create: if authed() && request.resource.data.uid == me() && a == request.resource.data.clubId + '_' + me();
      allow read: if authed() && (resource.data.uid == me() || isAdmin(resource.data.clubId));
      allow update: if isAdmin(resource.data.clubId);
    }

    match /personalGames/{g} {
      allow create: if authed() && request.resource.data.ownerUid == me();
      allow read, update, delete: if authed() && resource.data.ownerUid == me();
    }
    match /personalPeople/{p} {
      allow create: if authed() && request.resource.data.ownerUid == me();
      allow read, update, delete: if authed() && resource.data.ownerUid == me();
    }
  }
}
